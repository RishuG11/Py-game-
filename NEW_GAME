import cv2
import numpy as np
import pygame
import random
import sys
from tensorflow.keras.models import load_model

# -------------------------------------------------------------------
# 1. INITIALIZATION & SETUP
# -------------------------------------------------------------------
pygame.init()
WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("AI Basketball Hoop Game")
clock = pygame.time.Clock()

# Load Teachable Machine Model & Labels
try:
    model = load_model("keras_model.h5", compile=False)
    with open("labels.txt", "r") as f:
        class_names = [line.strip() for line in f.readlines()]
except Exception as e:
    print(f"Error loading model or labels file: {e}")
    print("Ensure 'keras_model.h5' and 'labels.txt' are in the same directory.")
    sys.exit()

# Start Webcam
cap = cv2.VideoCapture(0)
if not cap.isOpened():
    print("Error: Could not open camera.")
    sys.exit()

# -------------------------------------------------------------------
# 2. GAME VARIABLES
# -------------------------------------------------------------------
# Hoop variables
hoop_width, hoop_height = 120, 20
hoop_x = WIDTH // 2 - hoop_width // 2
hoop_y = HEIGHT - 60
hoop_speed = 12

# Ball variables
ball_radius = 15
ball_x = random.randint(ball_radius, WIDTH - ball_radius)
ball_y = 0
ball_speed = 6

# Game stats
score = 0
lives = 3
font = pygame.font.SysFont("Arial", 28, bold=True)

# -------------------------------------------------------------------
# 3. HELPER FUNCTIONS
# -------------------------------------------------------------------
def predict_movement(frame):
    """Preprocess frame and run prediction using Teachable Machine model."""
    # Resize image to 224x224 for Keras model input
    resized = cv2.resize(frame, (224, 224), interpolation=cv2.INTER_AREA)
    image_array = np.asarray(resized, dtype=np.float32).reshape(1, 224, 224, 3)
    # Normalize image array
    normalized_image_array = (image_array / 127.5) - 1
    
    # Predict
    prediction = model.predict(normalized_image_array, verbose=0)
    index = np.argmax(prediction)
    confidence_score = prediction[0][index]
    
    # Extract class label (removes numeric index prefix like '0 Left' -> 'Left')
    label_raw = class_names[index]
    label = label_raw.split(" ", 1)[-1].strip() if " " in label_raw else label_raw.strip()
    
    return label, confidence_score

def reset_ball():
    """Reset ball to the top at a random X coordinate."""
    global ball_x, ball_y, ball_speed
    ball_x = random.randint(ball_radius, WIDTH - ball_radius)
    ball_y = 0

# -------------------------------------------------------------------
# 4. MAIN GAME LOOP
# -------------------------------------------------------------------
running = True
current_direction = "Center / Neutral"

while running:
    # --- Event Handling ---
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # --- Camera & AI Processing ---
    ret, frame = cap.read()
    if not ret:
        continue
    
    # Mirror frame for natural webcam interaction
    frame = cv2.flip(frame, 1)
    
    # Run AI prediction
    label, confidence = predict_movement(frame)
    
    # Apply movement based on AI prediction (Confidence threshold > 60%)
    if confidence > 0.60:
        current_direction = label
        if label.lower() == "left":
            hoop_x -= hoop_speed
        elif label.lower() == "right":
            hoop_x += hoop_speed
    
    # Keep hoop inside screen boundaries
    hoop_x = max(0, min(WIDTH - hoop_width, hoop_x))

    # --- Game Logic Update ---
    ball_y += ball_speed
    
    # Collision check: Ball caught by hoop
    hoop_rect = pygame.Rect(hoop_x, hoop_y, hoop_width, hoop_height)
    ball_rect = pygame.Rect(ball_x - ball_radius, ball_y - ball_radius, ball_radius * 2, ball_radius * 2)
    
    if hoop_rect.colliderect(ball_rect):
        score += 1
        ball_speed += 0.3  # Increase difficulty gradually
        reset_ball()
        
    # Ball missed (hits bottom)
    elif ball_y > HEIGHT:
        lives -= 1
        reset_ball()
        if lives <= 0:
            # Game Over screen
            screen.fill((20, 20, 20))
            over_text = font.render(f"GAME OVER! Final Score: {score}", True, (255, 80, 80))
            screen.blit(over_text, (WIDTH // 2 - 180, HEIGHT // 2))
            pygame.display.flip()
            pygame.time.delay(3000)
            running = False

    # --- Drawing Elements ---
    screen.fill((30, 30, 40))  # Background color
    
    # Draw Hoop (Paddle)
    pygame.draw.rect(screen, (230, 100, 30), (hoop_x, hoop_y, hoop_width, hoop_height), border_radius=5)
    
    # Draw Ball
    pygame.draw.circle(screen, (240, 180, 40), (ball_x, ball_y), ball_radius)
    
    # Draw UI / HUD
    score_surface = font.render(f"Score: {score}", True, (255, 255, 255))
    lives_surface = font.render(f"Lives: {lives}", True, (255, 255, 255))
    ai_surface = font.render(f"AI Detection: {current_direction}", True, (80, 220, 120))
    
    screen.blit(score_surface, (20, 20))
    screen.blit(lives_surface, (WIDTH - 130, 20))
    screen.blit(ai_surface, (20, 60))
    
    # Display Computer Vision Output Window
    cv2.putText(frame, f"Move: {current_direction}", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
    cv2.imshow("Webcam Input - Teachable Machine", frame)

    # Refresh Pygame window
    pygame.display.flip()
    clock.tick(30)  # 30 FPS

    # Check for ESC key in OpenCV window
    if cv2.waitKey(1) & 0xFF == 27:
        break

# Cleanup resources
cap.release()
cv2.destroyAllWindows()
pygame.quit()